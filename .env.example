# =============================================================================
# EXEMPLO DE VARIAVEIS DE AMBIENTE
# -----------------------------------------------------------------------------
# Copie este arquivo para ".env.local" e preencha com os seus valores.
# O arquivo ".env.local" NAO vai para o GitHub (esta protegido no .gitignore).
# Nunca compartilhe as chaves em publico.
# =============================================================================

# URL do seu projeto no Supabase.
# Onde achar: painel do Supabase > Project Settings > Data API > Project URL.
# Exemplo: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave publica ("anon") do Supabase. Pode ficar exposta no navegador.
# Onde achar: painel do Supabase > Project Settings > API Keys > anon public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta de servico ("service_role") do Supabase.
# ATENCAO: e uma chave ADMIN. Usada apenas no servidor. NUNCA exponha no navegador.
# Onde achar: painel do Supabase > Project Settings > API Keys > service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Chave da API da Anthropic (Claude). Usada apenas no servidor para gerar as campanhas.
# Onde achar: https://console.anthropic.com > Settings > API Keys.
# Se ficar em branco, o app ainda roda e devolve um exemplo (stub) com um aviso.
ANTHROPIC_API_KEY=

# Modelo do Claude usado na geracao. Pode deixar o valor padrao abaixo.
ANTHROPIC_MODEL=claude-sonnet-5
